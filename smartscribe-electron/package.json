{
  "name": "smartscribe-electron",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5174 && npm run build:main && npm run build:preload && ELECTRON_RENDERER_URL=http://localhost:5174 electron .\"",
    "compile:swift": "swiftc src/main/swift/check-input.swift -o resources/bin/check-input && swiftc src/main/swift/active-window.swift -o resources/bin/active-window && swiftc src/main/swift/key-monitor.swift -o resources/bin/key-monitor",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --outfile=dist/main/index.js --external:electron --external:active-win",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --outfile=dist/preload/index.js --external:electron",
    "build": "tsc && vite build && npm run build:main && npm run build:preload",
    "build:mac": "npm run build && electron-builder build --mac",
    "build:win": "npm run build && electron-builder build --win"
  },
  "build": {
    "appId": "com.smartscribe.app",
    "productName": "SmartScribe",
    "icon": "resources/logo.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "protocols": [
      {
        "name": "SmartScribe Protocol",
        "schemes": [
          "smartscribe"
        ]
      }
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "amazon-cognito-identity-js": "^6.3.16",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron-store": "^8.2.0",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.11.0",
    "run-applescript": "^7.1.0"
  }
}